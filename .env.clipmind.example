# ==============================================================================
# ClipMind - Autonomous YouTube Shorts Generator & Uploader Configuration
# ==============================================================================

# Core Settings
CLIPMIND_NICHE=ai_tools
CLIPMIND_TIMEZONE=America/New_York
CLIPMIND_UPLOAD_FREQUENCY_HOURS=12
CLIPMIND_DRY_RUN=false
CLIPMIND_LOG_LEVEL=INFO
CLIPMIND_STATE_DIR=./data/clipmind_state
CLIPMIND_TEMP_DIR=./data/temp
CLIPMIND_OUTPUT_DIR=./output/clipmind

# ==============================================================================
# API Key Pool System (Comma-separated for multi-key rotation and failover)
# Pre-flight quota check requires >15% quota remaining per service.
# ==============================================================================

# YouTube Data API v3 Keys (Quota: 10,000 units/day per key)
YOUTUBE_API_KEYS=AIzaSyA_sample_key_1,AIzaSyB_sample_key_2,AIzaSyC_sample_key_3

# YouTube OAuth 2.0 Credentials (for uploading & channel management)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_OAUTH_TOKEN_FILE=token.json
YOUTUBE_CHANNEL_ID=UC_sample_channel_id
YOUTUBE_PLAYLIST_ID=PL_sample_playlist_id
YOUTUBE_DEFAULT_CATEGORY_ID=28

# OpenAI API Keys (for GPT-4o scripting, metadata, moderation)
OPENAI_API_KEYS=sk-proj-sample1...,sk-proj-sample2...
OPENAI_ORG_ID=org-sample

# SerpAPI / Google Search API Keys (for People Also Ask & Search Velocity)
SERPAPI_API_KEYS=serpapi_key_1,serpapi_key_2

# ElevenLabs Voice Synthesis API Keys (for high-engagement voiceovers)
ELEVENLABS_API_KEYS=xi-api-key-1,xi-api-key-2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Social & News Trend Sources
REDDIT_CLIENT_ID=reddit_client_id_here
REDDIT_CLIENT_SECRET=reddit_client_secret_here
REDDIT_USER_AGENT=ClipMindBot/1.0
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAA_sample_bearer_token
NEWSAPI_KEY=sample_newsapi_key

# ==============================================================================
# Google Drive Backup & Archival Integration
# ==============================================================================
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_CREDENTIALS_JSON=google_drive_credentials.json
GOOGLE_DRIVE_FOLDER_ID=1_sample_drive_folder_id
GOOGLE_DRIVE_ARCHIVE_DAYS=30

# ==============================================================================
# Video & Creative Specs (YouTube Shorts optimization)
# ==============================================================================
CLIP_MIN_DURATION_SEC=45
CLIP_MAX_DURATION_SEC=58
CLIP_RESOLUTION_WIDTH=1080
CLIP_RESOLUTION_HEIGHT=1920
CLIP_AUDIO_TARGET_LUFS=-14.0
CLIP_AUDIO_LRA=11.0
CLIP_AUDIO_TRUE_PEAK=-1.5
CLIP_MUSIC_DUCKING_DB=-18.0

# Subtitle Font Settings
SUBTITLE_FONT=Montserrat-Black
SUBTITLE_FONT_SIZE=48
SUBTITLE_PRIMARY_COLOR=&H0000FFFF
SUBTITLE_OUTLINE_COLOR=&H00000000

# ==============================================================================
# Safety, Moderation & Guardrails
# ==============================================================================
MODERATION_STRICT_MODE=true
MAX_RETRIES_PER_STAGE=3
FALLBACK_TOPICS_FILE=./data/fallback_topics.json
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
